        },
        {
          "info": {
            "name": "Create a JWT template",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.clerk.com/v1/jwt_templates",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create a JWT template"
        }
      ]
    }
  ],
  "bundled": true
}